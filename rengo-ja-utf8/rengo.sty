% rengo.sty - STYLE FILE FOR JAPAN JOINT AUTOMATIC CONTROL CONFERENCE
% 自動制御連合講演会論文集原稿作成用 スタイルファイル
% 英語で執筆する場合は rengo-en.cls を使用してください.
%
% Version 2021-4-30  第64回自動制御連合講演会実行委員会修正
% ・pLaTeX209をサポートから外し，pLaTeX2eのみ対応
% Version 2020-2-26  第63回自動制御連合講演会プログラム委員会修正
% Version 2019-7-10  第62回自動制御連合講演会プログラム委員会修正
% Version 2018-2.23からの主な変更点：
% ・日本語原稿と英語原稿で rengo.sty を共有していたために，英語原稿の執筆でも
%   日本語用のLaTeXコンパイラが必要でした．そこで英語原稿用に rengo-en.sty
%   を作成し，英語用のLaTeXコンパイラ，例えば pdflatex でもコンパイルできる
%   ようにしました．
% ・上記変更に伴い，\english コマンドを削除しました．
% ・QEDマークに \Box を使用していたために \usepackage{latexsym} する必要
%   がありました．QEDマークを \fbox で書き換え，latexsym が不要になりました
%
% usage:
%  \documentclass[a4paper]{jarticle}
%  \usepackage{rengo}
%
\NeedsTeXFormat{pLaTeX2e}
\ProvidesClass{rengo}[2021/04/30
 LaTeX document class for Japan Joint Automatic Control Conference (Rengo)]
%
% title, author, abstract
%
\newcommand{\jtitle}[1]{\gdef\@jtitle{#1}}
\newcommand{\etitle}[1]{\gdef\@etitle{#1}}
\newcommand{\jauthor}[1]{\gdef\@jauthor{#1}}
\newcommand{\eauthor}[1]{\gdef\@eauthor{#1}}
\newcommand{\englishabstract}[1]{\gdef\@englishabstract{#1}}
\newcommand{\keyword}[1]{\gdef\@keyword{#1}}

% Originates in article.cls
\renewcommand\maketitle{\par
  \begingroup
  \renewcommand\thefootnote{\@fnsymbol\c@footnote}%
  \def\@makefnmark{\rlap{\@textsuperscript{\normalfont\@thefnmark}}}%
  \long\def\@makefntext##1{\parindent 1em\noindent
    \hb@xt@1.8em{%
      \hss\@textsuperscript{\normalfont\@thefnmark}}##1}%
  \if@twocolumn
  \ifnum \col@number=\@ne
  \@maketitle
  \else
  \twocolumn[\@maketitle]%
  \fi
  \else
  \newpage
  \global\@topnum\z@   % Prevents figures from going at top of page.
  \@maketitle
  \fi
  \thispagestyle{empty}\@thanks % suppress page number
  \endgroup
  \setcounter{footnote}{0}%
  \global\let\thanks\relax
  \global\let\maketitle\relax
  \global\let\@maketitle\relax
  \global\let\@thanks\@empty
  \global\let\@jtitle\@empty
  \global\let\@jauthor\@empty
  \global\let\@etitle\@empty
  \global\let\@eauthor\@empty
  \global\let\@englishabstract\@empty
  \global\let\@keyword\@empty
  \global\let\jtitle\relax
  \global\let\jauthor\relax
  \global\let\etitle\relax
  \global\let\eauthor\relax
  \global\let\englishabstract\relax
  \global\let\keyword\relax
}
