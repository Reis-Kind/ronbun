\def\@maketitle{%
  \newpage
  \null
  %\vskip 2em%
  \begin{center}%
  \let \footnote \thanks
    {\LARGE\bfseries \@jtitle}%
    \vskip 1em%
    {\large \@jauthor}%
    \vskip 1em%
    {\large\bfseries \@etitle}%
    \vskip 1em%
    {\large \@eauthor}%
    \vskip 1em%
    \parbox{150mm}{\baselineskip 12pt \small
     \textbf{Abstract: }\@englishabstract\par
     \vskip 1em
     \textbf{Keywords: }\@keyword\par}
  \end{center}%
  \vskip 1em%
}

%
% caption of the figures and tables should be ``Fig.~ ...'' and ``Table ...''
%
\def\fnum@figure{Fig.~\thefigure}
\def\fnum@table{Table~\thetable}


%
% theorem text in \rm and label in \bf
%
\renewcommand{\@begintheorem}[2]{\trivlist \item[\hskip
  \labelsep{\bf #1\ #2\ }]}
\renewcommand{\@opargbegintheorem}[3]{\trivlist \item[\hskip
  \labelsep{\bf #1\ #2\ \rm [#3]\ }]}

%
% narrower spaces in equation array
%
\def\eqnarray{\stepcounter{equation}\let\@currentlabel=\theequation
\global\@eqnswtrue
\global\@eqcnt\z@\tabskip\@centering\let\\=\@eqncr
$$\halign to \displaywidth\bgroup\@eqnsel\hskip\@centering
  $\displaystyle\tabskip\z@{##}$&\global\@eqcnt\@ne
  \hfil$\displaystyle{{}##{}}$\hfil
  &\global\@eqcnt\tw@
   $\displaystyle\tabskip\z@{##}$\hfil
   \tabskip\@centering&\llap{##}\tabskip\z@\cr}

%
% adjust character size and spaces around section header
% Original from art10.sty
%
\def\section{\@startsection {section}{1}{\z@}{2.5ex plus 1ex minus
 .2ex}{1.5ex plus .2ex}{\large\bf}}
\def\subsection{\@startsection{subsection}{2}{\z@}{2.5ex plus 1ex minus
 .2ex}{1.5ex plus .2ex}{\normalsize\bf}}
\def\subsubsection{\@startsection{subsubsection}{3}{\z@}{2.5ex plus
1ex minus .2ex}{1.5ex plus .2ex}{\normalsize\bf}}
\def\paragraph{\@startsection
 {paragraph}{4}{\z@}{2.5ex plus 1ex minus .2ex}{-1em}{\normalsize\bf}}
\def\subparagraph{\@startsection
 {subparagraph}{4}{\parindent}{2.5ex plus 1ex minus
 .2ex}{-1em}{\normalsize\bf}}

%
% initialization
%
\twocolumn
\pagestyle{empty}

%
% paper size for A4
%
%-----------------
%\topmargin 0mm
%\oddsidemargin -5mm
%\evensidemargin -5mm
%
%\headheight 0pt
%\headsep 0pt
%\footskip 0pt
%\columnseprule 0pt
%\parindent 3mm
%\textheight 240mm
%\textwidth 172mm
%\columnsep 6mm
%-----------------
\sloppy
\flushbottom
\parindent 1em
\leftmargini 2em
\leftmarginv .5em
\leftmarginvi .5em
\oddsidemargin -5.4mm
\evensidemargin -5.4mm
\marginparwidth 48pt
\marginparsep 10pt
\textwidth 170mm
\textheight 250mm
\topmargin -20mm
\columnsep 7mm
%------------------

%
% preparation for theorems and lemmas
%
\newtheorem{definition}{定義}
\newtheorem{theorem}{定理}
\newtheorem{corollary}{系}
\newtheorem{lemma}{補題}
\newtheorem{proof}{証明}
  %
  % suppress numbering
  %
  \renewcommand{\theproof}{}
  %
  % put a box at the end of proof
  %
  \renewcommand{\endproof}{\raisebox{0.7ex}{\fbox{\rule{0pt}{0pt}}} \endtrivlist}
% end of rengo.sty
